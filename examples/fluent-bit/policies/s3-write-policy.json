{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTargetBucketPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::${BUCKET_NAME}",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "${PREFIX}/*"
          ]
        }
      }
    },
    {
      "Sid": "WriteObjectsToPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::${BUCKET_NAME}/${PREFIX}/*"
    }
  ]
}
